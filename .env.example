# Azure OpenAI Realtime target. Copy this file to .env and provide your own resource.
AZURE_OPENAI_DOMAIN=your-resource.openai.azure.com
AZURE_OPENAI_REALTIME_PATH=/openai/v1/realtime
AZURE_OPENAI_REALTIME_DEPLOYMENT=your-realtime-deployment

# Optional: user-assigned Managed Identity client ID. Omit for system-assigned MI.
AZURE_CLIENT_ID=

# Local development only: use the current `az login` session instead of MI.
AZURE_USE_DEFAULT_CREDENTIAL=0
VOICE_AGENT_HOST=127.0.0.1
VOICE_AGENT_PORT=8787
# Required in production, comma-separated. When omitted, only local HTTP origins are accepted.
VOICE_AGENT_ALLOWED_ORIGINS=

# Optional production browser URL. Local Vite development uses its proxy automatically.
VITE_VOICE_AGENT_URL=wss://your-gateway.example.com/voice-agent
