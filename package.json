{
  "name": "@hh1st/hoho-avatar",
  "version": "0.1.0-beta.3",
  "description": "A browser-first toolkit for building audio-reactive avatar experiences.",
  "author": "HH1st",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HH1st/hoho-avatar.git"
  },
  "homepage": "https://github.com/HH1st/hoho-avatar#readme",
  "bugs": {
    "url": "https://github.com/HH1st/hoho-avatar/issues"
  },
  "keywords": [
    "avatar",
    "lip-sync",
    "canvas",
    "audio",
    "typescript"
  ],
  "scripts": {
    "setup:demo": "npm --prefix examples/basic ci --registry=https://registry.npmjs.org",
    "setup:quickstart": "node scripts/setup-quickstart.mjs",
    "setup:live2d-sample": "node scripts/setup-live2d-sample.mjs",
    "dev": "npm --prefix examples/basic run dev --",
    "dev:voice-agent": "node --env-file-if-exists=.env server/voice-agent-gateway.mjs",
    "build": "npm --prefix examples/basic run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src examples server scripts tests e2e vite.sdk.config.mjs vitest.config.mjs playwright.config.mjs --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "dev:all": "node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "build:sdk": "vite build --config vite.sdk.config.mjs && tsc -p tsconfig.sdk.json && node scripts/finalize-sdk.mjs",
    "prepack": "npm run build:sdk",
    "test:package": "node scripts/test-package.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@azure/identity": "^4.13.2",
    "@pixi/unsafe-eval": "6.5.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "fflate": "^0.8.2",
    "kitten-tts-webgpu": "^0.1.1",
    "magic-string": "^0.30.21",
    "oxlint": "1.82.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "main": "./dist-sdk/index.js",
  "module": "./dist-sdk/index.js",
  "types": "./dist-sdk/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-sdk/types/index.d.ts",
      "import": "./dist-sdk/index.js"
    },
    "./characters/pixel-bot": {
      "types": "./dist-sdk/characters/pixel-bot.d.ts",
      "import": "./dist-sdk/characters/pixel-bot.js"
    },
    "./three": {
      "types": "./dist-sdk/types/three/index.d.ts",
      "import": "./dist-sdk/three.js"
    },
    "./canvas": {
      "types": "./dist-sdk/types/canvas/index.d.ts",
      "import": "./dist-sdk/canvas.js"
    },
    "./live2d": {
      "types": "./dist-sdk/types/live2d/index.d.ts",
      "import": "./dist-sdk/live2d.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-sdk/",
    "README.md",
    "LICENSE",
    "docs/SDK.md",
    "docs/THREE.md",
    "docs/LIVE2D.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist-sdk/audio-clip-processor.js"
  ],
  "peerDependencies": {
    "@pixi/unsafe-eval": "6.5.10",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.185.0"
  },
  "peerDependenciesMeta": {
    "@pixi/unsafe-eval": { "optional": true },
    "pixi.js": {
      "optional": true
    },
    "pixi-live2d-display": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  }
}
